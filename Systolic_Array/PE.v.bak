module PE(rst,clk,ain,bin,aout,bout,cout);
input rst,clk;
input [7:0] ain, bin;
output reg [7:0] aout, bout;
output reg [15:0] cout;

always @(posedge clk) 
if(rst) begin
aout <= 7'b0;
bout <= 7'b0;
cout <= 15'b0;
end
else begin
aout <= ain;
bout <= bin;
cout <= cout + aout*bout;
end

endmodule
