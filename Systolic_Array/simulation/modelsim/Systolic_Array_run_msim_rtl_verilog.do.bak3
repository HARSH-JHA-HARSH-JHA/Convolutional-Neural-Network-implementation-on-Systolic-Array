transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+E:/EE224_Project/Systolic_Array {E:/EE224_Project/Systolic_Array/PE.v}
vlog -vlog01compat -work work +incdir+E:/EE224_Project/Systolic_Array {E:/EE224_Project/Systolic_Array/Systolic_Array.v}

vlog -vlog01compat -work work +incdir+E:/EE224_Project/Systolic_Array {E:/EE224_Project/Systolic_Array/tb_Systolic_Array.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L fiftyfivenm_ver -L rtl_work -L work -voptargs="+acc"  tb_Systolic_Array

add wave *
view structure
view signals
run -all
