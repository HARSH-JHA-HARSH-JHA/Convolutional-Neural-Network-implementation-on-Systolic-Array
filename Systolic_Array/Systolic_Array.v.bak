module Systolic_Array(clk,rst,row,column,out);
input slk,rst;
input [63:0] row;
input [63:0] column;
output reg [511:0] out;

reg [15:0] a[1:4][1:5];
reg [15:0] b[1:5][1:4];
wire [31:0] c[1:4][1:4];

integer i,j;
always @(*) begin
for(i=1;i<=4;i=i+1) begin
a[i][1] <= row[16*i-1:16*i-16];
b[1][i] <= column[16*i-1:16*i-16];
for(j=1;j<=4;j=j+1) begin
out[i*128+j*32-129:i*128+j*32-160] <= c[i][j];
end 
end
end

genvar k,l;
generate for(k=1;k<=4;k=k+1) begin:gen1
generate for(l=1;l<=4;l=l+1) begin:gen2
PE p1(.rst(rst),.clk(clk),.ain(a[k][l]),.bin(b[k][l]),.aout(a[k][l+1]),.bout(b[k+1][l]),.cout(c[k][l]));
end
endgenerate
end
endgenerate

endmodule 